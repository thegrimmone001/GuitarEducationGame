{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glg.matchOptions.schema.v1.2",
  "title": "GLG Match Options (v1.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "enabled", "kind", "settings"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "kind": { "type": "string", "const": "matchOptions" },
    "settings": { "$ref": "glg.matchConfig.schema.v1.2" }
  }
}