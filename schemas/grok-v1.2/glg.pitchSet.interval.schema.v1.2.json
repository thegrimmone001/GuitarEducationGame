{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glg.pitchSet.interval.schema.v1.2",
  "title": "GLG Pitch Set — Interval (v1.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "enabled", "kind", "definition"],
  "properties": {
    "id": { "type": "string" },
    "enabled": { "type": "boolean" },
    "kind": { "type": "string", "const": "interval" },
    "label": { "type": "string" },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semitones"],
      "properties": {
        "semitones": { "type": "integer", "minimum": 0, "maximum": 12 },
        "quality": { "enum": ["perfect","major","minor","augmented","diminished"] },
        "direction": { "enum": ["ascending","descending"] }
      }
    }
  },
  "$defs": {
    "noteName": { "enum": ["C","C#","Db","D","D#","Eb","E","F","F#","Gb","G","G#","Ab","A","A#","Bb","B"] }
  }
}